# Copy this file to .env and fill in your API key for the harness you are using.
# The Makefile loads .env automatically.

# Harness to use: bob | claude | opencode  (default: bob)
# HARNESS=bob

# API key for IBM Bob (default harness)
# BOB_API_KEY=bob_prod_bob-user_...

# API key for Claude Code
# ANTHROPIC_API_KEY=sk-ant-...

# API key for OpenCode
# OPENAI_API_KEY=sk-...
